{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Git-Hospital/boards/schema/case.v1.json",
  "title": "boards case",
  "description": "One case.yaml. Semantic rules that a schema cannot express (provenance of exam cases, banned flags in commands, winnability) are checked by boards validate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "track", "kind", "set", "title", "provenance", "author", "oracle", "window", "expect"],
  "properties": {
    "id": {"type": "string", "pattern": "^(mesh|helm|code)/[a-z0-9][a-z0-9-]*$"},
    "track": {"enum": ["mesh", "helm", "code"]},
    "kind": {"enum": ["fault", "control"]},
    "set": {"enum": ["open", "exam"]},
    "title": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["synthetic", "issue", "postmortem", "cve"]},
        "url": {"type": ["string", "null"]},
        "note": {"type": "string"}
      }
    },
    "author": {"type": "string", "minLength": 1},
    "authorRelation": {"type": "array", "items": {"type": "string"}},
    "contaminatedFor": {"type": "array", "items": {"type": "string"}},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {"type": "string"},
        "service": {"type": "string"},
        "workload": {"type": "string"},
        "chart": {"type": "string"},
        "repo": {"type": "string"}
      }
    },
    "inject": {"$ref": "#/$defs/steps"},
    "reset": {"$ref": "#/$defs/steps"},
    "cleanTwin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inject": {"$ref": "#/$defs/steps"},
        "reset": {"$ref": "#/$defs/steps"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/oracle"}}
      }
    },
    "oracle": {"$ref": "#/$defs/oracle"},
    "settle": {"$ref": "#/$defs/duration"},
    "window": {"$ref": "#/$defs/duration"},
    "rubric": {"type": "string"},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verifiedBy"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "verifiedBy": {"type": "string", "minLength": 1}
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alarmWithin": {"$ref": "#/$defs/duration"},
        "resolvesWithin": {"$ref": "#/$defs/duration"},
        "culprits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "all"],
            "properties": {
              "level": {"enum": [1, 2]},
              "all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}}
            }
          }
        },
        "quiet": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["noPatch"],
          "properties": {
            "accept": {"type": "array", "items": {"$ref": "#/$defs/patchClass"}},
            "forbid": {"type": "array", "items": {"$ref": "#/$defs/patchClass"}},
            "noPatch": {"enum": ["pass", "fail"]},
            "healsWithin": {"$ref": "#/$defs/duration"}
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["expected", "tolerance"],
                "properties": {
                  "expected": {"type": "number"},
                  "tolerance": {"type": "number", "minimum": 0}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "duration": {"type": "string", "pattern": "^([0-9]+(ms|s|m|h))+$"},
    "patchClass": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "namespace": {"type": "string"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run"],
        "properties": {
          "desc": {"type": "string"},
          "run": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "stdin": {"type": "string"},
          "allowFail": {"type": "boolean"}
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "promql": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "op", "value"],
          "properties": {
            "query": {"type": "string", "minLength": 1},
            "op": {"enum": [">", ">=", "<", "<="]},
            "value": {"type": "number"},
            "noData": {"enum": ["unknown", "holds"]}
          }
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "workload", "since", "pattern"],
          "properties": {
            "namespace": {"type": "string"},
            "workload": {"type": "string"},
            "since": {"$ref": "#/$defs/duration"},
            "pattern": {"type": "string", "minLength": 1}
          }
        },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "pod", "command", "holdsWhen"],
          "properties": {
            "namespace": {"type": "string"},
            "pod": {"type": "string"},
            "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "holdsWhen": {"enum": ["fails", "succeeds"]}
          }
        },
        "exists": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"type": "string"},
            "namespace": {"type": "string"},
            "name": {"type": "string"}
          }
        },
        "all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/oracle"}},
        "script": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
